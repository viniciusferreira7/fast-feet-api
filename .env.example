SERVICE_NAME='fast-feet-api'
NODE_ENV=dev
PORT=3000
# Time the readiness probe keeps failing before the server closes, so the
# cluster can drain this instance out of its endpoints (ms)
SHUTDOWN_DRAIN_DELAY_MS=10000

# Database
DATABASE_URL=
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=


# JWT
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# CORS
CORS_ORIGIN="https://localhost:3000/"

# Argon
ARGON2_PEPPER=your-pepper

# Resend Email
RESEND_API_KEY=your-api-key
EMAIL="onboarding@resend.dev"

# Postal Code external service
POSTAL_CODE_EXTERNAL_SERVICE_URL=

# External HTTP test services
JSON_PLACEHOLDER_URL="https://jsonplaceholder.typicode.com"
HTTPBIN_URL="https://httpbin.org"

# Upload (AWS / Cloudflare)

## Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_TOKEN=
CLOUDFLARE_PUBLIC_URL=
CLOUDFLARE_PUBLIC_URL=

## S3
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRETE_ACCESS_KEY_ID=

# Tracer
OTLP_TRACE_EXPORT_ENDPOINT=

# Metrics
OTLP_METRICS_EXPORT_ENDPOINT=

# Admin Root
ADMIN_ROOT_CPF=
ADMIN_ROOT_EMAIL=
ADMIN_ROOT_PASSWORD=

# Password validation
PASSWORD_MIN_LENGTH=8
PASSWORD_MIN_SCORE=3