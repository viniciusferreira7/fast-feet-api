{
  "name": "fast-feet-api",
  "version": "1.44.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "prestart:dev": "docker compose --env-file .env up -d fast-feet-api-postgresql",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "docker:up": "docker compose --env-file .env up -d",
    "docker:down": "docker compose down",
    "docker:stop": "docker compose stop",
    "docker:build": "docker build -t fast-feet-api:latest -t fast-feet-api:$(git rev-parse --short HEAD) .",
    "docker:build:prod": "docker build --target production -t fast-feet-api:latest -t fast-feet-api:$(git rev-parse --short HEAD) .",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "check:fix": "biome check --write",
    "check:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "pretest:int": "node -e \"if (!process.env.CI) require('child_process').execSync('docker compose -f docker-compose.test.yaml up -d --wait', {stdio:'inherit'})\"",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "pretest:e2e": "node -e \"if (!process.env.CI) require('child_process').execSync('docker compose -f docker-compose.test.yaml up -d --wait', {stdio:'inherit'})\"",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e:watch": "vitest --config ./vitest.config.e2e.ts",
    "verify": "bash scripts/verify.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1025.0",
    "@fastify/static": "^9.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.216.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.1.0",
    "install": "^0.13.0",
    "p-retry": "^8.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.10.0",
    "rxjs": "^7.8.1",
    "unplugin-swc": "^1.5.9",
    "zod": "^4.2.1",
    "zod-validation-error": "^5.0.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@faker-js/faker": "^10.2.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/zxcvbn": "^4.4.5",
    "@vitest/coverage-v8": "^4.0.15",
    "drizzle-kit": "^0.31.10",
    "gerador-validador-cpf": "^6.3.0",
    "globals": "^16.0.0",
    "lefthook": "^2.1.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.15"
  }
}
