# Override env variables during tests


# Database — dedicated test database (create once: createdb -U postgres fast-feet-api-test)
DATABASE_URL=
DATABASE_PORT=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=

# Resend Email
RESEND_API_KEY=your-api-key
EMAIL="onboarding@resend.dev"

# Postal Code external service
POSTAL_CODE_EXTERNAL_SERVICE_URL=

# External HTTP test services (required in test environment)
JSON_PLACEHOLDER_URL=
HTTPBIN_URL=

## Upload (AWS / Cloudflare)
### Specify a different bucket name here to use only for testing
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRETE_ACCESS_KEY_ID=

# Client API Key — JWT signed with RS256, valid for 6 months
CLIENT_API_KEY=

# Admin Root
ADMIN_ROOT_CPF=00000000191
ADMIN_ROOT_EMAIL=john.doe@test.com
ADMIN_ROOT_PASSWORD=0b5c5g5e-7v1b-37bf-au7e-116b1038a46f

# Password validation
PASSWORD_MIN_LENGTH=8
PASSWORD_MIN_SCORE=3